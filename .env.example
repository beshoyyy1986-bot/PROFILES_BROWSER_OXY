CLOUDBROWSER_API_KEY=ضع_التوكن_هنا
APP_PASSWORD=باسورد_الدخول_للموقع
# بروكسي Oxylabs (اختياري): {user}-cc-{cc}-sessid-{sid}-sesstime-30
PROXY_HOST=pr.oxylabs.io
PROXY_PORT=7777
PROXY_USER=customer-xxxx
PROXY_PASS=xxxx
# PROXY_TEMPLATE={user}-cc-{cc}
# PROXY_STICKY=1
# PROXY_SESSTIME=30
# PROXY_MODE=template
# لو عملت Volume على Railway خليه /data
DATA_DIR=./data

# --- هوية ثابتة وحماية (اختياري) ---
# PERSIST_SESSION=0   # 0 = إلغاء حفظ الكوكيز/التخزين بين التشغيلات (SaveSession/RecoverSession في CloudBrowser)
# WEBRTC_PROTECT=0    # 0 = إلغاء حماية WebRTC (بتمنع iceServers عشان IP السيرفر ميتسربش)
# WEBRTC_ARGS=1       # 1 = كمان يبعت --force-webrtc-ip-handling-policy لـ CloudBrowser (جرّبه الأول، ممكن يستبدل الـ args الافتراضية)
